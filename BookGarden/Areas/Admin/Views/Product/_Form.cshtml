@model BookGarden.Models.ViewModels.ProductViewModel

@{
    var currentImageUrl = Model.Product.ImageUrl?.Trim();

    if (!string.IsNullOrWhiteSpace(currentImageUrl))
    {
        currentImageUrl = currentImageUrl.Replace('\\', '/');

        if (currentImageUrl.StartsWith("~/", StringComparison.Ordinal))
        {
            currentImageUrl = currentImageUrl[1..];
        }

        if (currentImageUrl.StartsWith("/Image/", StringComparison.OrdinalIgnoreCase))
        {
            currentImageUrl = "/images/" + currentImageUrl[7..];
        }
        else if (currentImageUrl.StartsWith("/Images/", StringComparison.OrdinalIgnoreCase))
        {
            currentImageUrl = "/images/" + currentImageUrl[8..];
        }
        else if (!currentImageUrl.StartsWith("/", StringComparison.Ordinal))
        {
            currentImageUrl = "/images/products/" + currentImageUrl;
        }
    }
}

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Product.Title" class="fairy-label"></label>
        <input asp-for="Product.Title" class="form-control fairy-input" />
        <span asp-validation-for="Product.Title" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Product.ISBN" class="fairy-label"></label>
        <input asp-for="Product.ISBN" class="form-control fairy-input" />
        <span asp-validation-for="Product.ISBN" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Product.Author" class="fairy-label"></label>
        <input asp-for="Product.Author" class="form-control fairy-input" />
        <span asp-validation-for="Product.Author" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Product.CategoryIdentification" class="fairy-label">Category</label>
        <select asp-for="Product.CategoryIdentification"
                asp-items="ViewBag.Categories"
                class="form-select fairy-input">
            <option value="">Select a category</option>
        </select>
    </div>

    <div class="col-12">
        <label asp-for="Product.Description" class="fairy-label"></label>

        <input type="hidden"
               asp-for="Product.Description"
               id="Product_Description" />

        <div id="product-description-editor"
             style="height: 200px; background: white;">
        </div>
    </div>

    <div class="col-md-4">
        <label asp-for="Product.ListPrice" class="fairy-label"></label>
        <input asp-for="Product.ListPrice"
               class="form-control fairy-input"
               type="number" step="0.01" />
    </div>

    <div class="col-md-4">
        <label asp-for="Product.Price50" class="fairy-label"></label>
        <input asp-for="Product.Price50"
               class="form-control fairy-input"
               type="number" step="0.01" />
    </div>

    <div class="col-md-4">
        <label asp-for="Product.Price100" class="fairy-label"></label>
        <input asp-for="Product.Price100"
               class="form-control fairy-input"
               type="number" step="0.01" />
    </div>

    <div class="col-12">
        <label asp-for="ImageFile" class="fairy-label">Product Image</label>
        @if (!string.IsNullOrWhiteSpace(currentImageUrl))
        {
            <div class="col-12">
                <label class="fairy-label">Current Product Image</label>
                <div>
                    <img src="@currentImageUrl"
                         alt="Current product image"
                         style="max-width: 200px; max-height: 200px; object-fit: contain;"
                         class="img-thumbnail" />
                </div>
            </div>
        }
        <input asp-for="ImageFile"
               type="file"
               accept="image/*"
               class="form-control fairy-input" />
    </div>
</div>