@model BookGarden.Models.ViewModels.ProductViewModel

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Product.Title" class="fairy-label"></label>
        <input asp-for="Product.Title" class="form-control fairy-input" />
        <span asp-validation-for="Product.Title" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Product.ISBN" class="fairy-label"></label>
        <input asp-for="Product.ISBN" class="form-control fairy-input" />
        <span asp-validation-for="Product.ISBN" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Product.Author" class="fairy-label"></label>
        <input asp-for="Product.Author" class="form-control fairy-input" />
        <span asp-validation-for="Product.Author" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Product.CategoryIdentification" class="fairy-label">Category</label>
        <select asp-for="Product.CategoryIdentification"
                asp-items="ViewBag.Categories"
                class="form-select fairy-input">
            <option value="">Select a category</option>
        </select>
    </div>

    <div class="col-12">
        <label asp-for="Product.Description" class="fairy-label"></label>
        <textarea asp-for="Product.Description"
                  class="form-control fairy-input"
                  rows="3"></textarea>
    </div>

    <div class="col-md-4">
        <label asp-for="Product.ListPrice" class="fairy-label"></label>
        <input asp-for="Product.ListPrice"
               class="form-control fairy-input"
               type="number" step="0.01" />
    </div>

    <div class="col-md-4">
        <label asp-for="Product.Price50" class="fairy-label"></label>
        <input asp-for="Product.Price50"
               class="form-control fairy-input"
               type="number" step="0.01" />
    </div>

    <div class="col-md-4">
        <label asp-for="Product.Price100" class="fairy-label"></label>
        <input asp-for="Product.Price100"
               class="form-control fairy-input"
               type="number" step="0.01" />
    </div>

    <div class="col-12">
        <label asp-for="ImageFile" class="fairy-label">Product Image</label>
        <input asp-for="ImageFile"
               type="file"
               accept="image/*"
               class="form-control fairy-input" />
    </div>
</div>