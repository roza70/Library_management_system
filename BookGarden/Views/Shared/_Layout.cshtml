<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookGarden</title>
    <script type="importmap"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookGarden.styles.css" asp-append-version="true" />
</head>
<body class="fairy-body d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg fairy-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="fairy-logo d-flex align-items-center justify-content-center">
                        <img src="~/Image/book.png" alt="BookGarden" style="width: 24px; height: 24px;" />
                    </div>
                    <span class="fairy-brand fs-5 d-none d-sm-inline">Book<span class="fairy-brand-accent">garden</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link fairy-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fairy-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fairy-link" asp-controller="Category" asp-action="Index">Categories</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="fairy-footer mt-auto py-4">
        <div class="container">
            <div class="row align-items-center gy-3">
                <div class="col-sm-4 d-flex align-items-center gap-3">
                    <div class="fairy-footer-icon d-flex align-items-center justify-content-center rounded-circle">
                        <i class="bi bi-book fs-5"></i>
                    </div>
                    <div>
                        <p class="mb-0 fw-semibold small">BookGarden</p>
                        <p class="mb-0 fairy-muted" style="font-size: 0.75rem;">Your Gateway to Endless Stories</p>
                    </div>
                </div>
                <div class="col-sm-4 text-center">
                    <p class="mb-0 fairy-muted small">&copy; @DateTime.Now.Year BookGarden. All rights reserved.</p>
                    <p class="mb-0 fairy-muted" style="font-size: 0.75rem;">Made with <i class="bi bi-heart-fill mx-1" style="color: #e8a0bf;"></i> by DotNetMastery</p>
                </div>
                <div class="col-sm-4 d-flex justify-content-sm-end justify-content-center gap-2">
                    <a href="#" class="fairy-social"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" class="fairy-social"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="fairy-social"><i class="bi bi-instagram"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>