@model BookGarden.Models.Category

<div class="container mt-4">
	<a asp-controller="Category" asp-action="Index" class="fairy-back-link d-inline-flex align-items-center gap-2 mb-3">
		<i class="bi bi-arrow-left"></i> Back to categories
	</a>

	<div class="card fairy-card overflow-hidden">
		<div class="fairy-card-header">
			<h5 class="mb-1 fw-bold text-danger"><i class="bi bi-trash me-2"></i>Delete Category</h5>
			<p class="mb-0 small fairy-subtitle">Are you sure you want to delete this category?</p>
		</div>

		<div class="card-body fairy-form-body">
			<dl class="row mb-4">
				<dt class="col-sm-4 fairy-label">Category Name</dt>
				<dd class="col-sm-8">@Model.Name</dd>

				<dt class="col-sm-4 fairy-label">Display Order</dt>
				<dd class="col-sm-8">@Model.DisplayOrder</dd>
			</dl>

			<form asp-action="Delete" method="post">
				<input asp-for="CategoryIdentification" type="hidden" />
				<button type="submit" class="btn btn-fairy-delete">
					<i class="bi bi-trash me-1"></i>Delete Category
				</button>
				<a asp-controller="Category" asp-action="Index" class="btn btn-fairy-cancel ms-2">Cancel</a>
			</form>
		</div>
	</div>
</div>
