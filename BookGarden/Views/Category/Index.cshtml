@model List<BookGarden.Models.Category>

<div class="container mt-4">
    <div class="card fairy-card overflow-hidden">
        <div class="fairy-card-header d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h5 class="mb-1 fw-bold"><i class="bi bi-stars me-2"></i>Categories</h5>
                <p class="mb-0 small fairy-subtitle">Manage your product categories</p>
            </div>
            <a asp-controller="Category" asp-action="Create" class="btn btn-fairy-new d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i> New Category
            </a>
        </div>

        <div class="table-responsive">
            <table class="table fairy-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 50%;">Category Name</th>
                        <th class="text-center" style="width: 20%;">Display Order</th>
                        <th class="text-end" style="width: 30%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td class="fairy-name">@category.Name</td>
                            <td class="text-center"><span class="fairy-badge">@category.DisplayOrder</span></td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a href="#" class="btn btn-sm btn-fairy-edit"><i class="bi bi-pencil-square me-1"></i>Edit</a>
                                    <a href="#" class="btn btn-sm btn-fairy-delete"><i class="bi bi-trash me-1"></i>Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>